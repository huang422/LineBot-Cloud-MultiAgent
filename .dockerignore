# Build context exclusions for the runtime image. Unlike .gitignore,
# patterns are anchored at the context root, so nested matches need **/.
.git
.gcloudignore
.gitignore

# Secrets: never bake dotenv files, migrate-v3 backups (<env file>.bak.<time>),
# generated Cloud Run env files or local agent settings into the image.
**/.env
**/.env.*
**/.cloudrun-env*
**/.claude
**/credentials.json
**/*.bak
**/*.bak.[0-9]*

# Local caches and tooling (the Cloud Build test step creates __pycache__)
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
.venv*
venv/
.vscode/
.DS_Store

# Not needed at runtime. Never list pyproject.toml or uv.lock: the
# Dockerfile's first stage exports uv.lock for pip --require-hashes.
README.md
DEPLOY.md
docs/
CONTEXT.md
tests/
scripts/
infra/
LICENSE
