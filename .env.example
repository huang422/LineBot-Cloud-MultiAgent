# ============================================================
# 設定說明（所有 key 的唯一說明都在這份檔案；README 只列必填與最常改的幾項）
# 使用方式：cp .env.example .env，再填入自己的值。
# - key 不分大小寫（與程式的 pydantic-settings 相同）；同一個 key 寫了幾次時以最後一行為準
# - 空值（KEY=）：下列 key 留空等於預設值，與部署腳本相同（src/config.py 的 EMPTY_MEANS_DEFAULT）：
#     TASKS_MODE、TASK_DISPATCH_DEADLINE_SECONDS、TASK_HANDLER_BUDGET_SECONDS、CLOUD_TASKS_QUEUE、
#     CLOUD_TASKS_COLAB_QUEUE、SCHEDULED_MESSAGES_ENABLED、SCHEDULED_WEEKLY_MESSAGES /
#     SCHEDULED_YEARLY_MESSAGES（沒有排程）、SCHEDULED_MESSAGES_TIMEZONE、PASSIVE_GROUP_RECORDING_ENABLED、
#     COLAB_ENABLED、COLAB_ADC_PATH；其他 key 留空就是空字串（例如 CLOUD_TASKS_LOCATION 留空＝Cloud Run 的 region）
# - 模型不是一個 key 一個模型，而是下方的模型角色表（MODEL_ROLES）
# - 每次部署先跑 python3 scripts/envfile.py check-v3 --file .env（只印 key 名稱，不印值）；
#   舊版 key 用 python3 scripts/envfile.py migrate-v3 --file .env 清理（會先備份），見最下方〈已停用的 key〉
# - 部署時 .env 去掉只給本機用的 key（最下方〈雲端部署〉區塊、GCP_PROJECT_ID、PORT、HOST、
#   GOOGLE_APPLICATION_CREDENTIALS；scripts/envfile.py 的 DEPLOY_ONLY_KEYS）後存成 Secret Manager 的 linebot-dotenv
# ============================================================

# ============================================================
# LINE API（必要；部署缺任一項會停止）
# LINE Developers Console → 你的 channel → Messaging API
# ============================================================
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_access_token

# ============================================================
# OpenRouter API（必要）
# https://openrouter.ai/keys 取得免費 API Key
# NVIDIA 失敗時的免費備援（對話 / 思考 / 視覺 / router / 輔助工作）都用這把 key；留空則停用所有 OpenRouter 層
# 免費額度以帳號計：20 次/分鐘、50 次/天（曾儲值 ≥ US$10 則 1000 次/天）
# 部署腳本要求這個 key；/health 的 ready_for_webhook 只要它或 NVIDIA_API_KEY 其一（兩者都設才有完整的備援鏈）
# ============================================================
OPENROUTER_API_KEY=your_openrouter_api_key
# false（建議）：只允許 :free 模型與 openrouter/free；角色表裡出現付費 id 時啟動就會失敗
OPENROUTER_ALLOW_PAID=false
# OpenRouter 帳號每天可用的 :free 請求數（所有免費模型共用；買過 $10 credits 為 1000）
OPENROUTER_FREE_DAILY_LIMIT=50

# ============================================================
# NVIDIA API（建議，大幅提升品質）
# https://build.nvidia.com 免費申請 API Key（模型頁標示：最多 40 次/分鐘、10,000 次/天；程式把它當成所有 NVIDIA 模型共用的額度，
#   對話、生圖與 embedding 都算）
# 模型下架（HTTP 410）時該模型在本次程序內停用；HTTP 404 則停用 6 小時後重試；兩者都會自動改走下一層
# 已下架、不可再使用：qwen/qwen3.5-397b-a17b、qwen/qwen3.5-122b-a10b、nvidia/nv-embedqa-e5-v5
# ============================================================
# 啟用 NVIDIA 的對話、視覺、router、utility 模型、embedding 與生圖（生圖與 episodic recall 只能走 NVIDIA）
# 可留空：只用 OpenRouter 的免費備援（沒有 embedding、生圖）
NVIDIA_API_KEY=
# 思考層沒有指定 reasoning_budget 時用的思考預算（tokens，最多 32768）：開啟思考時額外保留的 max_tokens；
# 有支援的模型（NVIDIA Super）也會收到同值的 reasoning_budget。NVIDIA Ultra 收到 reasoning_budget 會回
# HTTP 400，所以 Ultra 改用 medium_effort 思考，這個值只用來放寬 max_tokens
NVIDIA_THINKING_BUDGET=4096
# Episodic memory embeddings（embed 角色，nvidia/nemotron-3-embed-1b）；只在有 NVIDIA_API_KEY 時使用
# 模型輸出 2048 維，程式只取前 EMBEDDING_DIMENSIONS 維並重新 L2 正規化（沿用 1024 維 Firestore 索引，改這個值要先建新寬度的索引）
# 每筆向量標記 embedding_model / embedding_dim，recall 只比對目前模型的向量；換模型後跑 scripts/migrate_embeddings.py（預設 dry-run）
#   設計與回滾見 docs/adr/0011-embedding-migration.md
EMBEDDING_DIMENSIONS=1024
# 選填：自訂的 embeddings endpoint（預設 NVIDIA 的 embeddings API）
NVIDIA_EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings

# ============================================================
# 模型角色表（src/runtime/model_roles.py）：每個角色依序嘗試的模型層
# 程式內建預設：
#   router  ：Colab clef-flash:9b → NVIDIA Nemotron 3 Super（json_schema，temperature 0.1）
#             → NVIDIA Nemotron 3 Ultra（沒有結構化輸出，只靠 prompt 要求 JSON；temperature 0.1）
#             → OpenRouter Nemotron 3 Super :free（json_object，effort=none）
#   chat    ：Colab qwen3.8 27B → NVIDIA Nemotron 3 Super（關閉思考，模型卡取樣，45 秒）
#             → NVIDIA Nemotron 3 Ultra（關閉思考，25 秒）→ OpenRouter dots-3（effort=none，40 秒）
#             → OpenRouter Nemotron 3 Ultra :free（effort=none，40 秒）
#             （2026-10-16 起 Super 在 Ultra 前面：Ultra 每次呼叫都卡住，Super 都有回答；
#               兩個 NVIDIA 層都用滿時，dots-3 在 90 秒回覆期限內只剩約 20 秒再扣掉路由（與搜尋）的時間）
#   thinking：Colab qwen3.8 27B → NVIDIA Super（開啟思考，reasoning_budget＝NVIDIA_THINKING_BUDGET，60 秒）
#             → NVIDIA Ultra（開啟思考，medium_effort，不送 reasoning_budget，30 秒）
#             → OpenRouter dots-3（effort=medium，120 秒：由思考層的一半結束它）→ OpenRouter Nemotron 3 Ultra :free（effort=medium，30 秒），
#             之後接 chat 各層（關閉思考）；同一輪已經逾時的模型，若當時已用滿自己的上限，或後面的層給的時間沒多出 MIN_TIER_SECONDS 以上，就直接跳過
#   vision  ：Colab qwen3.8 27B（70 秒）→ NVIDIA Nemotron 3 Nano Omni（關閉思考，temperature 0.2，max_tokens 1024，15 秒）
#             → NVIDIA muse-glimmer 30B（關閉思考，35 秒）→ OpenRouter dots-3（effort=none，20 秒）
#             （有圖片的請求，不論哪個 agent 回答；API 層一律不思考，需要思考時只有 Colab 思考；
#               Nemotron Ultra 與 Super 只收文字，不在這個角色；引用的圖片若是 URL（訊息快取 / GCS）直接走 API 層，Colab 依設計略過）
#             有圖片的 prompt 只帶 3000 字的上下文（profile、最近對話由新到舊整輪保留、剩下的給長期摘要），
#               讓 prompt 維持約 4k tokens（muse-glimmer 在 6.2k tokens 時要約 40 秒）
#   utility（記憶摘要、搜尋查詢規劃、生圖提示改寫與說明文字；只收文字）：NVIDIA Super（temperature 0.2，30 秒）
#             → NVIDIA Nemotron 3 Ultra（關閉思考，30 秒）→ OpenRouter dots-3（effort=none，30 秒）
#             → OpenRouter Nemotron 3 Ultra :free（effort=none，30 秒）；四層合計在 MEMORY_SUMMARY_TIMEOUT_SECONDS（180 秒）內；
#             摘要超過 400 字時，更新前後各最多一次排序呼叫也走這幾層、共用這 180 秒（同一輪逾時過的模型不再呼叫）
#   embed   ：NVIDIA nemotron-3-embed-1b
#   image   ：NVIDIA FLUX.2 klein 4B（Apache 2.0）→ FLUX.1-dev（授權僅限非商業用途）
# OpenRouter 備援都是免費 id；dots-3（dots-studio/dots-3-note-preview:free，2026-10-16 取代 OpenRouter 自 10-13 撤下的
#   qwen/qwen3.8-27b:free）不是 NVIDIA 託管（上游 AtlasCloud），是 2026-12-31 到期的預覽版（每日下架檢查會提早標成 expiring）；
#   Nemotron :free 由 NVIDIA 託管、可能與 NIM 同時失效，所以排最後
# OpenRouter 以 HTTP 200 回傳、body 帶 error 物件的上游錯誤，依其 code 當成同一種錯誤（例如 503 是暫時性失敗），不是空回覆
# OpenRouter 回 502 / 503（HTTP 狀態或 body 的 code）且說明上游無法使用或過載時，等 1 秒用同一個請求重送一次
#   （算一次請求；模型冷卻中或免費額度用完時不重送；仍受該層時間上限約束）
# OpenRouter 的 429 若是單一模型的上游限流（temporarily rate-limited upstream），只冷卻該模型；
#   只有帳號層級的免費額度（free-models-per-day / per-min）才會冷卻所有 :free 模型 10 分鐘
# 取樣：層自己的 temperature 優先，其次是模型卡建議值（NVIDIA Nemotron Ultra / Super：1.0、top_p 0.95；muse-glimmer：0.6），
#   最後才是下面各 agent 的 *_TEMPERATURE；router 的 Super / Ultra 層與 utility 的 Super 層刻意維持低溫（0.1 / 0.1 / 0.2），讓分類與摘要穩定
# Colab 層要 COLAB_ENABLED=true 才啟用（見下方 Colab 區塊），否則一律停用（/health/detail 會列出原因）；隨需開機、閒置 15 分鐘釋放，
#   Colab READY 前每則訊息都直接由 NVIDIA → OpenRouter 立即回覆，不會等 Colab；
#   READY 後由 Colab 先回答，期限和其他請求一樣是 REPLY_WINDOW_SECONDS（90 秒），Colab 層最多用到期限前 20 秒
#   （短的期限則最多一半），Colab 變慢時 API 層仍有時間回覆
# Colab qwen3.8 固定用 Qwen 建議的取樣（不思考 0.7 / 0.8 / 20 / presence 1.5，思考 1.0 / 0.95 / 20），不受 *_TEMPERATURE 影響
# 每天第一次 /internal/cron 會排入下架檢查（eol 任務，不帶 API key）：模型下架、沒有 endpoint 等狀態改變記 ERROR log；
#   只有到期日的 expiring（模型還能用）只記 INFO、不告警（/health/detail 照樣看得到）；結果只存在記憶體，每個新 instance 第一次檢查會再記一次
# 舊的 NVIDIA_MODEL / ROUTER_MODEL / *_FALLBACK_MODEL / IMAGE_GEN_*_MODEL 等 key 已不再讀取；
#   舊 .env 可用 python3 scripts/envfile.py migrate-v3 --file .env 一次清理（會先備份）
# ============================================================
# 覆寫角色：JSON 物件 {角色: [模型層, ...]}，只取代列出的角色（整個角色換掉）
# 角色：router、chat、thinking、vision、utility、embed、image
# 每層：provider（colab | nvidia | openrouter）與 model 必填；選填 timeout_s、thinking（true/false）、
#   think（colab：false | low | medium | xhigh）、effort（openrouter：none | low | medium | high | xhigh）、
#   reasoning_budget、json_mode（json_schema | json_object | prompt）、max_tokens、temperature、
#   dim（embed，必須等於 EMBEDDING_DIMENSIONS）、steps（image）
# JSON 格式錯誤、未知角色 / provider、付費或已下架的 id、或模型做不到該角色時，啟動會直接失敗（不會默默略過）
# NVIDIA Nemotron 層沒自己設 temperature 時用模型卡的 1.0（不是 *_TEMPERATURE），所以 Super 層要自己帶低溫
# MODEL_ROLES='{"utility": [{"provider": "nvidia", "model": "nvidia/nemotron-3-super-120b-a12b", "thinking": false, "temperature": 0.2, "timeout_s": 30}, {"provider": "openrouter", "model": "dots-studio/dots-3-note-preview:free", "effort": "none", "timeout_s": 30}]}'
# colab：各角色的 Colab 層排最前面、clef-flash 在 API router 之前路由，通過限流的觸發訊息會記錄需求並自動開機；
# api：走 NVIDIA → OpenRouter 與原本的 API router，Colab 層排到最後（只在 Colab 已 READY 時使用，clef-flash 只在 API router 失敗時使用；
#   訊息不會自動開機，只有管理員 !colab on 會開）。COLAB_ENABLED=false 時兩者都只走 API 層；不論哪一種，回覆都不會等 Colab
MODEL_PATH_PREFERENCE=colab
# Colab qwen3.8 的思考等級（false | low | medium | xhigh）：一般對話與視覺 / router 判定需要深度思考時
# 預設 low，盡量在 LINE reply token 的 1 分鐘內回覆
COLAB_CHAT_THINK=low
COLAB_DEEP_THINK=medium

# ============================================================
# Colab 層（ADR-0010）：Colab A100 上的 Ollama（qwen3.8:27b-mtp-q4_K_M 回答、clef-flash:9b 路由）
#   Ollama 版本由 bot 每次開機時決定：GitHub 最新正式版（至少 colab/versions.json 的 min_version 0.40.4），
#   查不到或不能用時改用 versions.json 釘住的備援版本（0.40.5）；兩個模型都跟著 tag 走，digest 只記錄、不擋開機
# 所有使用者都先走 Colab（Colab 條款禁止提供網路服務與讓第三方使用 runtime，此風險已接受）
# 任何訊息都不會等 Colab：READY 前一律由 API 層立即回覆；模型正在回答別人時直接跳過（不排隊）
# 需要 FIRESTORE_ENABLED=true（session 狀態存在 {prefix}_colab/state）、COLAB_SHARED_SECRET、INTERNAL_CRON_SECRET 與可讀的 COLAB_ADC_PATH；
#   缺任何一項時啟動只記 WARNING，Colab 層維持停用（/health/detail 的 colab.reason 會寫原因），不會讓服務起不來
# 開機、保活、釋放都由每分鐘的 /internal/cron 決定，慢的步驟（assign、上傳並啟動 VM、heartbeat、釋放、對帳）走 colab task
# ============================================================
COLAB_ENABLED=false
# 至少 32 字元的隨機字串：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   每次 session 的註冊簽章金鑰與 Ollama bearer 都由它和 session id 導出，不另外儲存任何密鑰
COLAB_SHARED_SECRET=
# Colab 帳號的 refresh token（authorized_user JSON，用 scripts/mint_colab_adc.sh --apply 產生並存進 Secret Manager 的 linebot-colab-adc；
#   COLAB_ENABLED=true 時部署會把最新的 enabled 版本釘住版本號掛載到這個路徑，請保持預設）；
#   只有 Colab 控制平面會讀，不會設成 GOOGLE_APPLICATION_CREDENTIALS
COLAB_ADC_PATH=/secrets/colab/adc.json
# tunnel：quick（https://<隨機名稱>.trycloudflare.com）或 named（自己的 Cloudflare 網域，需要下面兩項）
COLAB_TUNNEL_MODE=quick
# named tunnel 的 hostname（例如 ollama.example.org）與 tunnel token；quick 時兩者留空
COLAB_TUNNEL_HOST=
COLAB_TUNNEL_TOKEN=
# clef-flash 路由：colab 偏好時排在 API router 之前，api 偏好時只在 API router 失敗時使用
# 下面三個門檻屬於路由模型本身：clef-flash 的機率沒有校準（T=1 的 softmax），
#   所以預設值是暫定的，可以用 scripts/evals/routing_eval.py 在標註過的繁中訊息上重新調整（換模型或 tag 更新後也要重調）
# 信心門檻（0.0–0.99）比的是 (最高機率 − 1/N) / (1 − 1/N)（Ollama 0.40.4 起由 llama.cpp 計算，不再是正規化熵）；
#   agent 與 output_format 都要達標，否則交給 API router。預設 0.0：一律採用機率最高的選項（argmax；完全同分時取字母順序最前的選項），
#   因為實際訊息的信心值只有 0.39–0.43，舊的 0.90 讓每一則都交給 API router
COLAB_ROUTER_ENABLED=true
COLAB_ROUTER_CONFIDENCE=0.0
# needs_thinking 的機率 ≥ THINK_ON（0.5–0.99）就開思考、≤ THINK_OFF（0.01–0.5）就關，中間交給規則判斷；THINK_ON 必須大於 THINK_OFF
COLAB_ROUTER_THINK_ON=0.85
COLAB_ROUTER_THINK_OFF=0.15
# 閒置多久（秒）就釋放：從最後一則需要 Colab 的觸發訊息、最後一次 !colab on、READY 三者中最晚的起算；
#   session 滿 COLAB_MAX_SESSION_SECONDS 也釋放（Colab 一般上限 12 小時）
COLAB_IDLE_TTL_SECONDS=900
COLAB_MAX_SESSION_SECONDS=39600
# CU（compute units）餘額低於此值不開機、開機中與 READY 中也會釋放；每天（台北時間）最多用這麼多 CU（依 ccu-info 的每小時用量累計）。
#   開機前要留得下「一次沒人用的 session」：一次開機逾時加一次閒置（A100 約 2.7 CU），否則 READY 當下就得釋放
COLAB_MIN_CU_BALANCE=10
COLAB_DAILY_CU_CAP=30
# assign 後這麼久（秒）還沒 READY 就釋放，算一次開機失敗；連續 3 次開機失敗會停用，直到 !colab on
COLAB_BOOT_TIMEOUT_SECONDS=900
# 開機中與使用中每隔多久（秒，60–900）在 kernel 執行一次保活 cell（Colab 只看 kernel 活動，tunnel 流量不算，約 22–25 分鐘沒活動就回收）
COLAB_HEARTBEAT_SECONDS=300
# true：這個 Colab 帳號只給 bot 用，帳號上不認得的 runtime 也會被釋放；false：只記 ERROR log（可能是你自己開的）
COLAB_ACCOUNT_DEDICATED=false
# 乾跑：改用 CPU runtime（不申請 A100），VM 以 DRYRUN=1 啟動假的 Ollama（通過就緒檢查但不回答），用來低成本走一遍整個控制流程
COLAB_DRY_RUN=false
# 可以使用 !colab on / off / status 的 LINE userId（逗號分隔）；私訊 bot 輸入 !whoami 可查自己的 userId
LINE_ADMIN_USER_IDS=

# ============================================================
# 模型分層的時間限制
# 每一層各自有時間上限（角色表的 timeout_s），且不超過回答期限（REPLY_WINDOW_SECONDS）
# 需要思考時先走 thinking 角色（開啟思考；thinking 各層合計最多用掉剩餘時間的一半），再走 chat 各層（關閉思考）
# 思考請求與生圖在私訊、群組都可以用到 TURN_DEADLINE_SECONDS（從開始處理事件起算；reply token 失效後改用 push）
# 一般回答開始時回覆期限剩不到 MIN_TIER_SECONDS 秒（延遲的事件或路由太慢），也改用 TURN_DEADLINE_SECONDS
# 某一層至少跑了 MIN_TIER_SECONDS 秒仍被期限切斷，才算該模型一次暫時性失敗（連續兩次冷卻兩分鐘）
# 同一輪裡某個模型跑了至少 MIN_TIER_SECONDS 秒還沒回答，後面同一個模型的層若給的時間沒比它用掉的多出 MIN_TIER_SECONDS 以上
#   （用滿自己上限的一律算），直接跳過（摘要記 skip(timed out earlier)）；chat 的工具迴圈各輪共用這份紀錄，下一個請求照常呼叫它
# TURN_DEADLINE_SECONDS 請保持在 TASK_HANDLER_BUDGET_SECONDS − 10 秒以下：event 任務在預算結束前 10 秒被切斷，
#   還沒回答的使用者仍會收到一則逾時通知
# ============================================================
TURN_DEADLINE_SECONDS=240
MIN_TIER_SECONDS=5
# 僅供測試（正式環境請留空）：停用其他所有模型層，只留指定的 provider 或模型，
# 例如 nvidia、openrouter、colab、nvidia:nvidia/nemotron-3-ultra-550b-a55b
# 若因此讓 router / chat / vision / utility 沒有可用的層（例如 COLAB_ENABLED=false 時設 colab），啟動會失敗
FORCE_TIER=

# ============================================================
# Router 設定（Orchestrator 路由分類，走角色表的 router 角色，一律關閉思考）
# 舊的 ORCHESTRATOR_MODEL / ORCHESTRATOR_FALLBACK_MODEL 已停用，留著部署會失敗，請刪除
# ============================================================
# 只用在沒有自己設定 temperature / max_tokens 的 router 層：預設的 NVIDIA Super / Ultra 層自帶 0.1 / 256，
# 所以這兩個值實際套用在 OpenRouter 備援層（以及 MODEL_ROLES 裡沒設這兩項的 router 層；
#   但 NVIDIA Nemotron 層沒設 temperature 時用模型卡的 1.0，不會用這個值）
# NVIDIA NIM 要求 temperature > 0；Colab 的 clef-flash 路由是計分呼叫，兩個值都不用
ORCHESTRATOR_TEMPERATURE=0.1
# Router 只需輸出一個短的 JSON 物件
ORCHESTRATOR_MAX_TOKENS=384

# ============================================================
# Per-Agent 溫度和 Token 限制
# 溫度只用在沒有模型卡取樣、也沒有自己設 temperature 的層（OpenRouter）；
# NVIDIA Nemotron Super / Ultra（沒自己設 temperature 的層）固定用模型卡的 1.0 / top_p 0.95，muse-glimmer 用 0.6；Colab 的 qwen3.8 固定用 Qwen 建議的取樣，也不看這些溫度。
# max_tokens 適用於所有層，包括 Colab 的 qwen3.8（num_predict＝這個值，思考時再加 NVIDIA_THINKING_BUDGET）；層自己設的 max_tokens 優先
# ============================================================
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=2048

VISION_TEMPERATURE=0.5
VISION_MAX_TOKENS=1024

WEB_SEARCH_TEMPERATURE=0.2
WEB_SEARCH_MAX_TOKENS=3072

# 生圖第一階段：utility 各層把需求改寫成英文 prompt（只收文字）時用。第二階段的生圖模型是 image 角色：
#   FLUX.2 klein 4B（4 steps，60 秒）→ FLUX.1-dev（50 steps，90 秒），都在 TURN_DEADLINE_SECONDS 內，需要 NVIDIA_API_KEY；
#   klein 的安全過濾擋下時改用 FLUX.1-dev 再試一次，仍被擋下就用繁中請使用者換個描述。
#   換模型或步數用 MODEL_ROLES，例如 {"image": [{"provider": "nvidia", "model": "...", "steps": 4}]}
IMAGE_GEN_TEMPERATURE=0.7
IMAGE_GEN_MAX_TOKENS=1024

# ============================================================
# GCP Cloud Storage（語音+圖片暫存公開 URL）
# Signed URL 預設 48 小時失效；物件由 bucket 的 3 天 lifecycle 規則刪除
# （部署腳本會檢查 / 補上），應用程式只在傳送失敗時立即刪除該物件
# bucket 必須是 US-WEST1 / US-CENTRAL1 / US-EAST1 的 STANDARD bucket（Always Free 5 GB），否則部署會停止
# 沒設定 GCS_BUCKET_NAME 時文字回覆照常，語音與生圖改回文字
# 舊的 GCS_MEDIA_CLEANUP_DELAY_SECONDS 已停用（不再有程序內的延遲刪除），可直接刪掉
# GOOGLE_APPLICATION_CREDENTIALS：只給本機的 GCP SDK 用的憑證 JSON 路徑（SDK 自動從環境讀取）；
#   Cloud Run 上用 runtime service account，這個 key 不會部署過去。一般請保持空白
# ============================================================
GCS_BUCKET_NAME=
GCS_SIGNED_URL_EXPIRY_HOURS=48
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# 網路搜尋（ADR-0009）：Tavily → 不搜尋、直接回答並附註
# 先用 Tavily 搜尋；Tavily 無法使用（沒有設定、額度用完、被限速）或查無結果時，
# 模型依既有知識回答，開頭註明「（目前無法使用搜尋服務…可能不是最新資訊）」，不回固定錯誤訊息
# 搜尋查詢不帶日期：「今天 / 最近 / 這個月 / 今年」等時間詞會換成搜尋的時間範圍；
# 續問（例如「那高雄呢」）會先依最近對話改寫成完整的搜尋字串（utility 模型）
# ------------------------------------------------------------
# SEARCH_FETCH_TOP_N：讀取前幾筆結果的網頁全文（0＝只用摘要）；
#   SEARCH_FETCH_MAX_BYTES：每頁最多讀幾 bytes（解壓縮後）；SEARCH_FETCH_BUDGET_SECONDS：同一次搜尋
#   （或同一則訊息裡的網址）所有網頁共用的時間上限，時間到就用已讀到的，也不會超過搜尋階段剩下的時間
#   （搜尋階段在回覆期限前 20 秒結束；反正會用 push 送出的回答則以 turn 期限計算）。
#   抓取會擋內網、metadata、link-local 等位址，也不保留 cookie
# SEARCH_RERANK_ENABLED：用 embedding（embed 角色）依語意重排結果再讀網頁，
#   每次搜尋多 2 次 NVIDIA embedding 呼叫、共用 3 秒預算；預設關閉
# TAVILY_API_KEY：可選（https://tavily.com，每月 1,000 credits 免費；basic 搜尋 1 credit）
#   沒有 key 時，TAVILY_KEYLESS_ENABLED=true 會用 keyless 模式（免費、有速率限制）；
#   兩者都沒有＝不搜尋。TAVILY_KEYLESS_ENABLED 沒設時預設 false：v2 的 .env
#   以空白 TAVILY_API_KEY 關閉搜尋，升級後仍維持關閉；這份範本明確設為 true
# 舊的 WEB_SEARCH_MONTHLY_QUOTA 已停用（沒有 app 內配額；Tavily 用量見 /health/detail），可直接刪掉
# 舊的 SEARXNG_*（自架搜尋，2026-10-01 為維持 GCP 免費額度而移除）已停用，可直接刪掉
# ============================================================
SEARCH_FETCH_TOP_N=3
SEARCH_FETCH_MAX_BYTES=2000000
SEARCH_FETCH_BUDGET_SECONDS=6
SEARCH_RERANK_ENABLED=false
TAVILY_API_KEY=
TAVILY_KEYLESS_ENABLED=true

# ============================================================
# TTS 語音設定（edge-tts 完全免費）
# 可用語音列表: https://github.com/rany2/edge-tts
# 語音回覆需要 GCS_BUCKET_NAME（音訊上傳後以 signed URL 傳給 LINE）
# ============================================================
TTS_VOICE=zh-TW-HsiaoChenNeural
TTS_ENABLED=true

# ============================================================
# 機器人設定
# ============================================================
# prompt 裡機器人的名字
BOT_NAME=Assistant
# 可選：若要精準判斷 LINE mention 是否真的提到機器人，可填入 bot 的 LINE userId
LINE_BOT_USER_ID=

# ============================================================
# 排程訊息（群組定期提醒 + 生日祝福）
# 注意：排程訊息永遠使用 push（依 LINE 的每月額度計費，程式不另外計數或限制）
# SCHEDULED_WEEKLY_MESSAGES / SCHEDULED_YEARLY_MESSAGES 請填 JSON 陣列
# 若想換行排版，請用單引號包住整段 JSON
# 觸發機制：Cloud Run scale-to-zero，無法用 in-process timer。
#   只要設定 INTERNAL_CRON_SECRET，./scripts/deploy_cloud_run.sh 就會建立 / 更新
#   一個每分鐘呼叫 /internal/cron 的 Cloud Scheduler job（X-Cron-Token 共用密鑰）；
#   secret 留空時會刪除該 job，/internal/cron 也一律 403。
# ============================================================
SCHEDULED_MESSAGES_ENABLED=false
# LINE 群組 ID（從 webhook log 中取得，群組發訊息時會記錄）
# 格式: C1234567890abcdef1234567890abcdef
SCHEDULED_GROUP_ID=
# 每週 / 每年的 job（JSON 陣列）；每年的 02-29 job 在非閏年改在 02-28 發送（ADR-0002）
SCHEDULED_WEEKLY_MESSAGES=[]
SCHEDULED_YEARLY_MESSAGES=[]
# 比對 job 的星期、日期與時間所用的時區
SCHEDULED_MESSAGES_TIMEZONE=Asia/Taipei
# /internal/cron 與 /health/detail（X-Cron-Token）的共用密鑰。SCHEDULED_MESSAGES_ENABLED=true 時必填；
# 設定後即使沒開排程訊息，部署也會保留每分鐘的 Cloud Scheduler job：它也寫入逾時的群組訊息緩衝、
#   排入每日模型下架檢查、執行 Colab 控制器（建議一律設定）。留空時部署刪除該 job，兩個 endpoint 一律 403
# 產生建議：openssl rand -hex 32
INTERNAL_CRON_SECRET=
# 範例：
# SCHEDULED_WEEKLY_MESSAGES='[
#   {"id":"monday_workout_reminder","day_of_week":"mon","hour":21,"minute":0,"message":"Hi"},
#   {"id":"pineapple_workout_reminder","day_of_week":"mon","hour":21,"minute":30,"message":"Hi"}
# ]'
# SCHEDULED_YEARLY_MESSAGES='[
#   {"id":"birthday_reminder_0312","month":3,"day":12,"hour":9,"minute":0,"message":"Hi"}
# ]'

# ============================================================
# Webhook 之後的工作（Cloud Tasks）
# Cloud Run 採用 request-based 計費（--cpu-throttling），回應送出後程序幾乎拿不到 CPU，
# 所以回覆、群組訊息寫入、圖片快取、記憶摘要都改成 Cloud Tasks 任務：
# 由 Cloud Tasks 再打一次 POST /internal/tasks/{kind}，這是一個真正的 request，有 CPU 可用。
# 每分鐘的 /internal/cron 也會順便寫入逾時未滿門檻的群組訊息緩衝。
# ============================================================
# auto（建議）：在 Cloud Run 上且 INTERNAL_TASKS_SECRET 有值時用 Cloud Tasks，否則在 request 內直接處理
# cloud：一律用 Cloud Tasks（secret 留空時仍會退回 inline）；inline：一律在 request 內處理（本機開發）
TASKS_MODE=auto
# Cloud Tasks queue 名稱與 location；部署腳本會用同樣的值建立 / 更新 queue（每個任務只送一次，不重試）
# CLOUD_TASKS_QUEUE 留空即預設值 linebot-events；CLOUD_TASKS_LOCATION 留空＝Cloud Run 的 region
CLOUD_TASKS_QUEUE=linebot-events
# Colab 控制器的 colab 任務（每個數秒到數分鐘）專用的 queue，不佔 LINE 事件 queue 的派送名額；
# COLAB_ENABLED=true 時部署腳本才建立它（2 個並行名額），必須與 CLOUD_TASKS_QUEUE 不同，留空即預設值
CLOUD_TASKS_COLAB_QUEUE=linebot-colab
CLOUD_TASKS_LOCATION=us-west1
# Cloud Tasks 回呼的服務網址，只接受 https://；留空時從第一個通過驗證的 request 的 Host 推得（一律用 https，建議留空）
PUBLIC_BASE_URL=
# /internal/tasks 的共用密鑰（X-Tasks-Token），與 INTERNAL_CRON_SECRET 分開、不會沿用
# TASKS_MODE 不是 inline 時部署必填；留空時 /internal/tasks 一律 403
# 產生建議：openssl rand -hex 32
INTERNAL_TASKS_SECRET=
# Cloud Tasks 等待單一任務回應的上限（秒，15–1800）
# 部署腳本會把 Cloud Run 的 --timeout 設成 max(300, 這個值)，避免 Cloud Run 先切斷任務
TASK_DISPATCH_DEADLINE_SECONDS=300
# 單一任務處理的時間預算（秒），必須小於上面的 dispatch deadline（否則部署會失敗）
# 注意：任務 request 的整段時間（含等待模型回應）都算 Cloud Run 的 vCPU-s／GiB-s 用量
TASK_HANDLER_BUDGET_SECONDS=280
# 回答期限：每個請求的一般回答（私訊與群組，不論由 Colab 或 API 層回答）都要在 LINE 事件時間 + 這個秒數內完成；
#   Colab 層最多用到期限前 20 秒，留給 API 備援層。必須小於 TURN_DEADLINE_SECONDS（否則啟動失敗）
#   （思考回答與生圖可用到 TURN_DEADLINE_SECONDS）。LINE reply token 只保證約 1 分鐘有效，但不論過了多久一律先試免費的 reply，
#   LINE 確定拒絕（token 過期 / 無效）才改用 push；push 不計數、不設上限，只受 LINE 自己的每月額度限制
# 任務在訊息送出超過這個秒數後才開始會記錄警告（reply token 可能已過期，多半會改用 push）
# COLAB_REPLY_WINDOW_SECONDS 已不再讀取（2026-10-01 起只有這一個期限）
REPLY_WINDOW_SECONDS=90

# ============================================================
# Rate Limit：每位使用者在 RATE_LIMIT_WINDOW_SECONDS 秒的滑動視窗內最多 RATE_LIMIT_MAX_REQUESTS 個請求
# ============================================================
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================
# 對話記憶（主 prompt 記憶）
# !new 會清除當前 user / group / room 的 recent window、long-term summary 與 episodic recall 記錄（跨聊天室的 user profile 不清）
# ============================================================
# 近期文字訊息累積到這個數量就排入壓縮（compact 任務）；它只觸發摘要，不截斷訊息（ADR-0003）
MEMORY_RECENT_MESSAGE_LIMIT=6
# 摘要（compact 任務）的時間上限（秒）；逾時時保留原本的近期訊息
MEMORY_SUMMARY_TIMEOUT_SECONDS=180
# 只用在沒有自己設 temperature、模型也沒有模型卡取樣的 utility 層（OpenRouter）；
#   預設的 NVIDIA Super 層自帶 0.2，NVIDIA Ultra 層（和沒帶的 Super 層）用模型卡的 1.0
MEMORY_SUMMARY_TEMPERATURE=0.2
# 摘要被 max_tokens 截斷時不採用，改用下一個 utility 層；都沒有可用的摘要時保留原本的摘要與最近訊息，
#   這個聊天室 15 分鐘後再試（近期訊息達安全上限一半時 1 分鐘）；低於 768 啟動會警告
MEMORY_SUMMARY_MAX_TOKENS=768
# 壓縮防抖（秒）：上次壓縮後這段時間內又超過上限時，等下一則訊息再壓縮
#   （近期訊息累積到安全上限的一半時仍會立即壓縮）；0 = 關閉
COMPACTION_DEBOUNCE_SECONDS=120
# 每個聊天室最多每隔這麼久存一筆 episode（recall_memory 查詢用）；
#   期間的壓縮內容會併入下一筆，只保留最新 2000 字（更早的只留在長期摘要裡）；0 = 每次壓縮都存
EPISODE_MIN_INTERVAL_SECONDS=3600

# ============================================================
# 群組被動訊息記錄（沒有觸發 bot 的群組 / 多人聊天室文字訊息）
# true：先放進程序內的緩衝再合併寫入記憶，之後 !hej / @提及 時看得到前面的對話；false：只記錄 bot 有回答的對話
# 緩衝達到 PASSIVE_GROUP_FLUSH_THRESHOLD 則由 passive_flush 任務寫入；最舊一則超過 PASSIVE_GROUP_FLUSH_DELAY_SECONDS 秒時，
#   由下一則訊息或每分鐘的 /internal/cron（需要 INTERNAL_CRON_SECRET）寫入；bot 回答該群組前也會先寫入
# ============================================================
PASSIVE_GROUP_RECORDING_ENABLED=true
PASSIVE_GROUP_FLUSH_THRESHOLD=8
PASSIVE_GROUP_FLUSH_DELAY_SECONDS=30

# ============================================================
# 持久化長期記憶（Firestore Native，可選）
# 預設 false：使用 in-memory backend（Cloud Run scale-to-zero 會清空）
# 設成 true 後會把長期記憶搬到 Firestore Native，跨重啟保留
#
# 免費額度：每天 50K reads / 20K writes，儲存 1 GiB（足夠個人 / 小群組 LINE bot；儲存量最容易先用完，見 DEPLOY.md 的索引豁免）
# Firestore region 請務必跟 Cloud Run 同 region (us-west1) 避免跨區 egress 費用
# 預設 database=(default)；若你想用 Firestore named database 才需要改
# ============================================================
FIRESTORE_ENABLED=false
# 留空時使用執行環境的預設專案（Cloud Run service account / 本機 ADC）
FIRESTORE_PROJECT_ID=
# database 的位置在建立時就決定（DEPLOY.md：gcloud firestore databases create --location=us-west1），這裡不用設定
FIRESTORE_DATABASE="(default)"
# Firestore collection 前綴：實際 collection 會是 {prefix}_chat_memory / {prefix}_user_profile / {prefix}_episodes（Colab 另有 {prefix}_colab）
FIRESTORE_COLLECTION_PREFIX=linebot
# 同一個 chat 連續訊息共用本機 read cache 的秒數（降低 Firestore reads 用量）
MEMORY_CACHE_TTL_SECONDS=60
# 從 LINE 取得的 displayName 在記憶體快取多久（秒）
LINE_PROFILE_CACHE_TTL_SECONDS=86400

# ============================================================
# 伺服器（HOST / PORT 只給本機執行用，不會部署；Cloud Run 自己設定 PORT）
# ============================================================
HOST=0.0.0.0
PORT=8080
# DEBUG、INFO、WARNING、ERROR 或 CRITICAL
LOG_LEVEL=INFO

# ============================================================
# 雲端部署（deploy_cloud_run.sh / provision_gcp.sh 讀取這些設定，不會部署到 Cloud Run）
# ============================================================
# 第一次先跑 ./scripts/provision_gcp.sh（預設 dry-run，逐步加 --apply），之後每次部署跑 ./scripts/deploy_cloud_run.sh
# Cloud Build 只跑 ruff / pytest 並建置、推送 image（以 linebot-builder 身分）；部署在本機執行
# 已 provision：.env 以 Secret Manager secret linebot-dotenv 掛載到 /secrets/app/app.env（.env 有變才新增版本），
#   Cloud Run 以 linebot-runtime 身分執行；尚未 provision：改用系統暫存目錄的 env YAML（結束即刪除）
# 值裡不能有 ${（python-dotenv 會展開變數），部署會列出 key 名稱並停止
# min instances 固定為 0（scale-to-zero），max instances 固定為 1
# CLOUD_RUN_SERVICE_ACCOUNT 留空 = 已 provision 時用 linebot-runtime，否則沿用 Cloud Run 既有設定；
#   自訂時該帳號需要 linebot-dotenv 的 roles/secretmanager.secretAccessor
# 預設保留 2 個 revision / 2 個 image（Artifact Registry 免費額度 0.5 GB）；設 1 只留目前的 revision 與 image（不能切流量回滾，
#   linebot-dotenv 仍至少留最新 2 個版本）；想保留更多回滾空間可調大
#   （只數 Ready 的 revision，從未 Ready 的失敗 revision 不佔名額；保留中的 revision 用到的 image 不會刪；
#   每個保留的 revision 也保留它的 secret 版本；Secret Manager 免費 6 個有效版本）
#   但跑過 provision_gcp.sh --step ar-cleanup-enforce 之後，Artifact Registry 只留最新 2 個 image，
#   其他一天後刪除：調到 2 以上不會多出回滾空間（部署會警告）
# DEPLOY_ENABLE_APIS=true：部署時自動啟用需要的 GCP API
# 部署也會在這些設定會讓服務壞掉時停止：TASKS_MODE 不是 inline 而 INTERNAL_TASKS_SECRET 是空的、
#   TASK_HANDLER_BUDGET_SECONDS 不小於 TASK_DISPATCH_DEADLINE_SECONDS、CLOUD_TASKS_COLAB_QUEUE 等於 CLOUD_TASKS_QUEUE、
#   GCS_BUCKET_NAME 不在 Always Free 的 region
GCP_PROJECT_ID=your_project_id
CLOUD_RUN_SERVICE_NAME=linebot-cloud-agent
CLOUD_RUN_REGION=us-west1
CLOUD_RUN_SERVICE_ACCOUNT=
DEPLOY_KEEP_REVISIONS=2
DEPLOY_KEEP_IMAGES=2
DEPLOY_ENABLE_APIS=true

# ============================================================
# 已停用的 key（python3 scripts/envfile.py check-v3 --file .env 在每次部署前檢查，只印 key 名稱）
# 部署會拒絕：
#   - 任何 key 或 MODEL_ROLES 的模型層寫著已下架的 qwen/qwen3.5-397b-a17b、qwen/qwen3.5-122b-a10b、
#     nvidia/nv-embedqa-e5-v5（HTTP 410；src/config.py 的 RETIRED_MODEL_IDS）
#   - ORCHESTRATOR_MODEL、ORCHESTRATOR_FALLBACK_MODEL（路由改走 router 角色；LEGACY_ENV_KEYS）
#   - REQUIRE_REASONING_MODELS=true（v2 會默默丟掉備援模型的過濾）
#   - 不是 JSON 物件的 MODEL_ROLES，或 python-dotenv 讀不懂的引號值
# 只提醒、不擋部署（src/config.py 的 REMOVED_ENV_KEYS；啟動時也會列出仍存在的）：逐模型的 key（NVIDIA_MODEL、
#   ROUTER_MODEL、*_FALLBACK_MODEL、IMAGE_GEN_*_MODEL、IMAGE_GEN_STEPS、IMAGE_GEN_CFG_SCALE、NVIDIA_EMBEDDING_MODEL 等）、
#   各種 reasoning 開關、THINKING_TIMEOUT_SECONDS、GCS_MEDIA_CLEANUP_DELAY_SECONDS、WEB_SEARCH_MONTHLY_QUOTA、
#   FIRESTORE_LOCATION、SEARXNG_*、LINE_PUSH_* 與 LINE_REPLY_FALLBACK_PUSH_ENABLED、COLAB_REPLY_WINDOW_SECONDS；
