# Secrets: dotenv files (the template stays tracked), migrate-v3 backups
# (<env file>.bak.<time>; .env.* covers those of .env), generated Cloud Run
# env files and local agent settings.
.env
.env.*
!.env.example
*.bak
*.bak.[0-9]*
.cloudrun-env.generated.*
.claude/
credentials.json

# Caches and virtualenvs
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv*/
venv/

# Editors and OS
.vscode/
.DS_Store
/tmp/
